# Neon-Postgres: gepoolte Verbindung für die App (…-pooler.…neon.tech)
DATABASE_URL="postgresql://benutzer:passwort@ep-beispiel-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Direkte Verbindung ohne Pooler – Prisma braucht sie für Migrationen
DIRECT_URL="postgresql://benutzer:passwort@ep-beispiel.eu-central-1.aws.neon.tech/neondb?sslmode=require"

